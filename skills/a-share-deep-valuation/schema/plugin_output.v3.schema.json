{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v3/plugin_output.v3.schema.json",
  "title": "v3 子流程统一输出接口（plugin_output v3，草案） · r4",
  "type": "object",
  "required": [
    "business_model",
    "plugin_version",
    "as_of",
    "currency",
    "base_year",
    "profit_base",
    "drivers",
    "FV3",
    "FV3_build",
    "dps_path",
    "multiple_anchor",
    "fragility",
    "kill_lines",
    "forecast_ledger_entries",
    "data_gaps"
  ],
  "properties": {
    "business_model": {
      "enum": [
        "M1",
        "M2",
        "M2b",
        "M3",
        "M4",
        "M5a",
        "M5b",
        "M5c",
        "M5d",
        "M6",
        "M6b",
        "M7a",
        "M7b",
        "M8",
        "M9"
      ]
    },
    "secondary_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "plugin_version": {
      "type": "string"
    },
    "as_of": {
      "type": "string"
    },
    "currency": {
      "enum": [
        "CNY",
        "HKD"
      ]
    },
    "base_year": {
      "type": "object",
      "required": [
        "metric",
        "fy",
        "method",
        "value",
        "source"
      ],
      "properties": {
        "method": {
          "enum": [
            "9M+priorQ4",
            "TTM_4Q",
            "FY_actual"
          ]
        }
      },
      "description": "V§2-2 r2: 9M+priorQ4 when Q3 out; else TTM_4Q; FY_actual needs fy_actual_reason"
    },
    "profit_base": {
      "type": "object",
      "required": [
        "reported_ni",
        "core_ni",
        "cfo",
        "avg_total_assets",
        "maint_capex",
        "da",
        "piotroski",
        "maint_capex_basis"
      ],
      "properties": {
        "hedge_fx_addback": {
          "type": "number"
        },
        "hedge_fx_cap": {
          "type": [
            "number",
            "null"
          ]
        },
        "owner_earnings": {
          "type": "number"
        },
        "maint_capex_basis": {
          "enum": [
            "disclosed",
            "DA_proxy",
            "DA_proxy_capped_capex"
          ]
        },
        "sbc_added_back_in_core": {
          "type": "boolean"
        },
        "sbc": {
          "type": "number"
        },
        "sbc_treatment": {
          "enum": [
            "deducted_in_OE",
            "deducted_in_NI3",
            "sensitivity_same_basis_multiple"
          ]
        }
      }
    },
    "drivers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "name",
          "bear",
          "base",
          "bull",
          "source",
          "is_top2",
          "anchor_id"
        ]
      },
      "description": "exactly two items with is_top2=true (validator)"
    },
    "FV3": {
      "type": "object",
      "required": [
        "bear",
        "base",
        "bull"
      ],
      "description": "除息每股价值，第三个完整财年年末"
    },
    "FV3_build": {
      "type": "string"
    },
    "dps_path": {
      "type": "object",
      "required": [
        "dps_min3",
        "dps_fy",
        "policy_source"
      ]
    },
    "multiple_anchor": {
      "type": "object",
      "required": [
        "kind",
        "value",
        "multiple_basis",
        "exit_date_convention",
        "method",
        "fy3",
        "n_years"
      ],
      "properties": {
        "kind": {
          "enum": [
            "PE",
            "PB",
            "PEV",
            "SOTP",
            "DDM",
            "EV_EBIT",
            "EV_EBITDA",
            "PS"
          ]
        },
        "multiple_basis": {
          "enum": [
            "same_FY",
            "PB_same_date",
            "EV_same_date",
            "EV_same_FY",
            "SOTP_component_same_FY"
          ]
        },
        "exit_date_convention": {
          "const": "FY3_yearend"
        },
        "fy3": {
          "type": "string"
        },
        "n_years": {
          "type": "number"
        },
        "bear": {
          "type": "number"
        },
        "base": {
          "type": "number"
        },
        "bull": {
          "type": "number"
        },
        "total_mcap_pe_used": {
          "type": "boolean"
        },
        "window_exception_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "trim_fail_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshots": {
          "type": "array",
          "description": "required for every window multiple (PE/SOTP/EV_*/PS)",
          "items": {
            "type": "object",
            "required": [
              "fy",
              "price_date",
              "profit_fy",
              "price",
              "price_basis",
              "shares_mn",
              "shares_basis",
              "fx_date",
              "value",
              "source"
            ],
            "properties": {
              "price_basis": {
                "const": "unadjusted"
              },
              "shares_basis": {
                "enum": [
                  "YE_issued",
                  "period_weighted_YE"
                ]
              },
              "core_margin": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "profit margin for trough screen"
              },
              "exclude_from_base_bull": {
                "type": "boolean"
              },
              "exclude_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mcap_report_ccy": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "portfolio_deduct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "net_cash": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "core_ni": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "fx": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "roe": {
      "type": "object",
      "description": "M5*/M7* 必填",
      "required": [
        "avg3",
        "latest_annualized",
        "base",
        "bear",
        "worst_hist"
      ]
    },
    "bvps": {
      "type": "object",
      "description": "M5*/M7* 必填",
      "required": [
        "value",
        "date",
        "date_rule"
      ]
    },
    "fragility": {
      "type": "object",
      "required": [
        "test",
        "flips_decision_at_price",
        "frag_TR"
      ]
    },
    "kill_lines": {
      "type": "array",
      "minItems": 1
    },
    "forecast_ledger_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "metric",
          "period",
          "p10",
          "p50",
          "p90",
          "anchor_ids"
        ]
      }
    },
    "display_checks": {
      "type": "object",
      "description": "R4–R6 inputs (DISPLAY). Money in bn of report ccy unless *_price_ccy; shares in mn.",
      "properties": {
        "ni0": {
          "type": "number"
        },
        "ni3_base": {
          "type": "number"
        },
        "g_pct": {
          "type": "number"
        },
        "ronic_pct": {
          "type": "number"
        },
        "price": {
          "type": "number"
        },
        "price_ccy": {
          "type": "string"
        },
        "shares_mn": {
          "type": "number"
        },
        "fx_price_ccy_per_report": {
          "type": "number"
        },
        "hurdle_pct": {
          "type": "number"
        },
        "n_years": {
          "type": "number"
        },
        "dps_min3": {
          "type": "number"
        },
        "multiple_base": {
          "type": "number"
        },
        "portfolio_after_disc": {
          "type": "number"
        },
        "net_cash": {
          "type": "number"
        }
      }
    },
    "notes_double_count": {
      "type": "string"
    },
    "data_gaps": {
      "type": "array"
    },
    "fiscal_year_end": {
      "type": "string",
      "description": "MM-DD, default 12-31"
    },
    "FV3_components": {
      "type": "object",
      "description": "M8 required: per scenario core_ni3, core_pe, portfolio_after_disc, net_cash, fx_price_ccy_per_report, shares_mn"
    },
    "portfolio": {
      "type": "object",
      "description": "M8: smoothing_rule, fy3_treatment, listed/unlisted legs"
    },
    "bear_margin": {
      "type": "object",
      "required": [
        "bear",
        "worst_in_window",
        "worst_last3"
      ],
      "description": "A.L1.bear_stress.margin: bear ≤ worst in window, or exemption_reason and ≤ worst of last 3 FYs",
      "properties": {}
    },
    "methods": {
      "type": "array",
      "description": "r4: ≥2 independent methods before B20, OR dual_method_exception. Independence = different primary driver or value identity (not two PE twins).",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "FV3_base"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "e.g. same_FY_PE, SOTP, reverse_DCF, DDM, PB_ROE, P_EV, total_return"
          },
          "FV3_base": {
            "type": "number"
          },
          "basis": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "trough_exclusion": {
      "type": "object",
      "description": "r3/RC1 structure: which snapshots excluded from base/bull and why",
      "properties": {
        "trough_margin_gap_pp": {
          "type": "number",
          "description": "PROVISIONAL_UNBACKTESTED default 3"
        },
        "excluded_fys": {
          "type": "array"
        },
        "screened": {
          "type": "boolean"
        }
      }
    },
    "sbc_sensitivity_both_sides": {
      "type": "object",
      "description": "r3/RC5: both-sides SBC sensitivity only; never headline",
      "properties": {
        "B20_TR": {
          "type": "number"
        },
        "B22_TR": {
          "type": "number"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "dual_method_exception": {
      "type": "object",
      "description": "r4: escape when V§20 pending or data gap blocks second method",
      "required": [
        "code",
        "reason"
      ],
      "properties": {
        "code": {
          "enum": [
            "V20_pending",
            "data_gap"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "business_model": {
            "pattern": "^(M5|M7)"
          }
        }
      },
      "then": {
        "required": [
          "roe",
          "bvps"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "business_model": {
            "pattern": "^M8$"
          }
        }
      },
      "then": {
        "required": [
          "FV3_components",
          "portfolio",
          "display_checks",
          "bear_margin"
        ]
      }
    }
  ]
}
