{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v3/card.v3.schema.json",
  "title": "v3 决策卡（valuation_decision v3，草案） · r4",
  "type": "object",
  "required": [
    "ticker",
    "name",
    "as_of",
    "price",
    "price_date",
    "business_model",
    "method_by_model",
    "method_mismatch",
    "exit_date_convention",
    "exit_multiple",
    "grade",
    "hurdle",
    "FV3",
    "dps_min3",
    "buy_point",
    "B20_issued",
    "return_sell",
    "fragility",
    "position_band",
    "plugin_output_ref",
    "validate_report",
    "review",
    "forecast_ledger_entries",
    "anchor_trace"
  ],
  "properties": {
    "ticker": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "as_of": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "price_date": {
      "type": "string"
    },
    "business_model": {
      "enum": [
        "M1",
        "M2",
        "M2b",
        "M3",
        "M4",
        "M5a",
        "M5b",
        "M5c",
        "M5d",
        "M6",
        "M6b",
        "M7a",
        "M7b",
        "M8",
        "M9"
      ]
    },
    "model_change_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "method_by_model": {
      "type": "string"
    },
    "method_mismatch": {
      "type": "boolean"
    },
    "exit_date_convention": {
      "const": "FY3_yearend"
    },
    "exit_multiple": {
      "type": "object",
      "required": [
        "kind",
        "bear",
        "base",
        "bull",
        "multiple_basis",
        "window",
        "fy3",
        "n_years"
      ],
      "properties": {
        "multiple_basis": {
          "enum": [
            "same_FY",
            "PB_same_date",
            "EV_same_date",
            "SOTP_component_same_FY"
          ]
        }
      }
    },
    "grade": {
      "type": "object",
      "required": [
        "display",
        "quality_grade",
        "confidence"
      ]
    },
    "hurdle": {
      "type": "object",
      "required": [
        "primary_pct",
        "secondary_pct"
      ]
    },
    "FV3": {
      "type": "object",
      "required": [
        "bear",
        "base",
        "bull"
      ]
    },
    "dps_min3": {
      "type": "number"
    },
    "buy_point": {
      "type": "object",
      "required": [
        "stack_dividend",
        "formula"
      ],
      "description": "B20_TR=(FV3_base+n×DPS_min3)/(1+h)^n, n=exit_multiple.n_years. When B20_issued=false, B20_TR/B22_TR may be null.",
      "properties": {
        "B20_TR": {
          "type": [
            "number",
            "null"
          ],
          "description": "null allowed iff B20_issued=false"
        },
        "B22_TR": {
          "type": [
            "number",
            "null"
          ]
        },
        "stack_dividend": {
          "type": "boolean"
        },
        "formula": {
          "type": "string"
        }
      }
    },
    "return_sell": {
      "type": "object",
      "required": [
        "base_revert_ann_pct",
        "line_pct",
        "cash_breakeven_price",
        "applicable"
      ]
    },
    "fragility": {
      "type": "object",
      "required": [
        "frag_TR",
        "r_bear",
        "fragile",
        "results_B20_TR"
      ]
    },
    "position_band": {
      "type": "object"
    },
    "plugin_output_ref": {
      "type": "string"
    },
    "validate_report": {
      "type": "object",
      "required": [
        "fails",
        "displays",
        "validator_version"
      ]
    },
    "review": {
      "type": "object",
      "required": [
        "independent",
        "author_id",
        "reviewer_id",
        "verdict",
        "premortem",
        "anchor_checklist"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "PASS",
            "PASS_WITH_CHANGES",
            "FAIL",
            "PENDING"
          ]
        }
      }
    },
    "forecast_ledger_entries": {
      "type": "array",
      "minItems": 1
    },
    "anchor_trace": {
      "type": "object",
      "description": "字段→叶子锚点 id"
    },
    "L4_anchors": {
      "type": "array"
    },
    "external_crosscheck": {
      "type": "object",
      "description": "r3 S4c. Validator-required before B20_issued. Thresholds PROVISIONAL_UNBACKTESTED.",
      "required": [
        "ext_sources",
        "methods",
        "B20_internal",
        "B20_final",
        "range",
        "basis"
      ],
      "properties": {
        "ext_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "url",
              "fetched_at",
              "basis"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "fetched_at": {
                "type": "string"
              },
              "basis": {
                "enum": [
                  "non-IFRS",
                  "IFRS",
                  "扣非"
                ]
              },
              "n_analysts": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "kind": {
                "type": "string"
              }
            }
          }
        },
        "methods": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "FV3_base"
            ]
          }
        },
        "consensus_ni3": {
          "type": [
            "number",
            "null"
          ]
        },
        "consensus_adj": {
          "type": [
            "number",
            "null"
          ]
        },
        "deviation_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "deviation_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "optimism_haircut_pct": {
          "type": "number",
          "description": "PROVISIONAL_UNBACKTESTED default 10"
        },
        "consensus_tol_pct": {
          "type": "number",
          "description": "PROVISIONAL_UNBACKTESTED default 15"
        },
        "method_spread_max": {
          "type": "number",
          "description": "PROVISIONAL_UNBACKTESTED default 1.25"
        },
        "B20_internal": {
          "type": "number"
        },
        "B20_final": {
          "type": "number"
        },
        "range": {
          "type": "object",
          "required": [
            "min",
            "max",
            "values"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "values": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        "basis": {
          "enum": [
            "non-IFRS",
            "IFRS",
            "扣非"
          ]
        },
        "at_price_by_range": {
          "type": "boolean",
          "description": "true only if price ≤ every value in range"
        },
        "external_fv_display": {
          "type": [
            "object",
            "null"
          ],
          "description": "DISPLAY only"
        }
      }
    },
    "methods": {
      "type": "array",
      "description": "r4 dual-method; required when B20_issued=true (≥2 independent)",
      "minItems": 2
    },
    "range_buy": {
      "type": "object",
      "description": "r4: required when B20_issued=true; B20=min(range)",
      "required": [
        "B20_TR",
        "range_min",
        "range_max",
        "at_price_whole_range"
      ],
      "properties": {
        "B20_TR": {
          "type": "number"
        },
        "range_min": {
          "type": "number"
        },
        "range_max": {
          "type": "number"
        },
        "at_price_whole_range": {
          "type": "boolean"
        }
      }
    },
    "B20_issued": {
      "type": "boolean",
      "description": "r4: required always. false if dual-method/triangulation/S4c gate failed → B20_TR may be null"
    },
    "round_delta": {
      "type": "object",
      "description": "r3/RC3: required when B20 up >5% (provisional) or at-price status flips vs prior",
      "properties": {
        "prior_B20_TR": {
          "type": [
            "number",
            "null"
          ]
        },
        "prior_at_price": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "b20_up_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "status_flipped": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "listed_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "change",
              "direction",
              "b20_contribution",
              "author_reason"
            ]
          }
        },
        "b20_up_disclose_pct": {
          "type": "number",
          "description": "PROVISIONAL_UNBACKTESTED default 5"
        }
      }
    },
    "display_vs_gate": {
      "type": "object",
      "description": "r3: explicit separation",
      "properties": {
        "display_only": {
          "type": "array"
        },
        "gates": {
          "type": "array"
        }
      }
    },
    "sbc_sensitivity_both_sides": {
      "type": "object",
      "description": "r3/RC5"
    },
    "gate_block_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "required non-empty when B20_issued=false"
    },
    "prior_card_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "r4/RC3: if set, round_delta required"
    },
    "prior_as_of": {
      "type": [
        "string",
        "null"
      ],
      "description": "r4/RC3: prior card as_of; if set with ledger prior, round_delta required"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "B20_issued": {
            "const": true
          }
        },
        "required": [
          "B20_issued"
        ]
      },
      "then": {
        "required": [
          "external_crosscheck",
          "methods",
          "range_buy"
        ],
        "properties": {
          "buy_point": {
            "type": "object",
            "required": [
              "B20_TR",
              "B22_TR",
              "stack_dividend",
              "formula"
            ],
            "properties": {
              "B20_TR": {
                "type": "number"
              },
              "B22_TR": {
                "type": "number"
              }
            }
          },
          "methods": {
            "type": "array",
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "B20_issued": {
            "const": false
          }
        },
        "required": [
          "B20_issued"
        ]
      },
      "then": {
        "required": [
          "gate_block_reason"
        ],
        "properties": {
          "gate_block_reason": {
            "type": "string",
            "minLength": 1
          },
          "buy_point": {
            "type": "object",
            "properties": {
              "B20_TR": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "B22_TR": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
